# По умолчанию используется native USDC на Base:
# 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
export PAYMENT_TOKEN=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Только для forge --verify.
export BASESCAN_API_KEY=
